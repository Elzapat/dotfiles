[env]
TERM = "alacritty"

[font]
size = 11.5

[font.bold]
family = "JetBrainsMono Nerd Font"

[font.bold_italic]
family = "JetBrainsMono Nerd Font"

[font.italic]
family = "JetBrainsMono Nerd Font"

[font.normal]
family = "JetBrainsMono Nerd Font"

[[keyboard.bindings]]
action = "SpawnNewInstance"
key = "Return"
mods = "Control|Shift"

[[keyboard.bindings]]
action = "Up"
key = "L"
mode = "Vi|~Search"

[[keyboard.bindings]]
action = "Down"
key = "K"
mode = "Vi|~Search"

[[keyboard.bindings]]
action = "Left"
key = "J"
mode = "Vi|~Search"

[[keyboard.bindings]]
action = "Right"
key = "M"
mode = "Vi|~Search"

[window]
dynamic_padding = true

[window.padding]
x = 15
y = 6

